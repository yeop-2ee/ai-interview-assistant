PORT=5050

# ──────────────────────────────────────────
# LLM 모델 설정 (aiServer.js)
# 두 모델이 같은 Ollama 서버라면 *_SERVER_URL은 동일하게 두면 됩니다.
# ──────────────────────────────────────────

# llama: 면접 질문 생성 / 꼬리질문 생성 / 리포트 꼬리질문 추출
LLAMA_SERVER_URL=http://localhost:11434
LLAMA_MODEL=llama3.1:8b

# gemma: 이력서·자소서 분석 / 리포트 본문 작성
GEMMA_SERVER_URL=http://localhost:11434
GEMMA_MODEL=gemma3:12b

# ──────────────────────────────────────────
# 파인튜닝 데이터 생성 (generate_training_data.js)
# ──────────────────────────────────────────
# GOOGLE_API_KEY=...    # aistudio.google.com에서 발급 (무료, 하루 1,500회)
# GENERATOR_MODEL=gemini-2.0-flash   # 생략 시 기본값 사용
# DELAY_MS=500                       # 요청 간 딜레이 (기본 500ms)
